# Copy to .env and fill in.  .env is git-ignored; this file is tracked.
# Never commit real credentials.

# --- MT5 broker credentials (all three REQUIRED from Phase 1.6 onward) ---
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- NewsAPI (utils/news_reader.py). No fallback: unset = news sentiment disabled ---
NEWS_API_KEY=

# --- Live-trading safety interlock (consumed from Phase 1.6) ---
# Must be exactly "true" to permit trading a non-demo account.
ALLOW_LIVE=false
