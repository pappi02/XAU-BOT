# MetaTrader 5 Credentials
# Your MT5 account number (numeric)
MT5_ACCOUNT=12345678

# Your MT5 account password
MT5_PASSWORD=YourPassword123

# Your MT5 broker server (e.g., Broker-Demo, Broker-Live)
MT5_SERVER=YourBroker-Demo

# API Keys
# Your API key (if using external data sources)
API_KEY=your_api_key_here

# Your secret key (if using external data sources)
SECRET_KEY=your_secret_key_here

# News API Key - Get from https://newsapi.org/
NEWS_API_KEY=your_news_api_key_from_newsapi_org

# Trading Settings
# Set to "demo" for demo account or "live" for live trading
TRADE_ACCOUNT_MODE=demo

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Risk Management
# Risk per trade as percentage of account balance (0.1 to 5.0)
RISK_PER_TRADE_PCT=0.3

# MT5 Terminal Path (optional, defaults to standard installation)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

